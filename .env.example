ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=your_mssql_database;User Id=your_mssql_userId;Password=your_mssql_password;TrustServerCertificate=True

Jwt__SecretKey=your_super_secret_jwt_key_min_32_characters_long
Jwt__ExpirationMinutes=60

Gemini__ApiKey=your_gemini_api_key
Gemini__Model=gemini-2.5-flash

